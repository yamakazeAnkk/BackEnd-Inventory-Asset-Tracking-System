{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "user-service-group",
    "AutoOffsetReset": 0,
    "EnableAutoCommit": true,
    "AutoCommitIntervalMs": 1000,
    "SessionTimeoutMs": 30000,
    "HeartbeatIntervalMs": 3000
  }
}
